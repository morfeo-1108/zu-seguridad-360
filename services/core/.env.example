# ZU Core — LOCAL DEVELOPMENT/TEST ONLY. Never use this file outside localhost Compose.
PORT=4001
ENV=development
AUTO_MIGRATE=true
PILOT_SYNTHETIC_ENABLED=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Real Google self-signup is unavailable in this synthetic profile.
# Configure only in a separately reviewed staging/production environment.
GOOGLE_SIGNUP_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SIGNUP_TERMS_URL=
GOOGLE_SIGNUP_PRIVACY_URL=
GOOGLE_SIGNUP_TERMS_VERSION=
GOOGLE_SIGNUP_PRIVACY_VERSION=

# Must match docker-compose.dev.yml local Postgres/Redis/RabbitMQ values.
DB_HOST=postgres
DB_PORT=5432
DB_USER=zuadmin
DB_PASSWORD=zupassword
DB_NAME=zu_core_synthetic
DB_SSLMODE=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=zuredis123
RABBITMQ_URL=amqp://zurabbit:zurabbit123@rabbitmq:5672/zu_vhost

# Local-only signing key; never reuse or deploy.
JWT_SECRET=ZU360_LOCAL_TEST_ONLY_DO_NOT_REUSE_2026_8b76c1ff8f12

VAULT_ENABLED=false
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=zu-vault-dev-token
VAULT_SECRET_PATH=secret/data/zu360/core
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=zu-documents-local
OTEL_ENDPOINT=http://prometheus:4317
